#!/usr/bin/env node
"use strict";

const SerialBridge = require('../lib/serial_bridge'),
      Lightboard = require('../lib/lightboard'),
      config = require('../config.json').default;


config.device = 'lightboard';

global.log = {}
global.log.debug = console.log;
global.log.info = console.log;

let args = process.argv.slice(0);
args.shift();
args.shift();

let serialBridge = SerialBridge(config),
    lightboard = new Lightboard(serialBridge, config),
    renderCallback = lightboard.render.bind(lightboard),
    Animation = require(`../lib/programs/lightboard/animations/${args[0]}`),
    animation = new Animation(config, renderCallback);

if (args[0] === 'battery') {
    animation.setMode(args[1] || 'charging');
    if (typeof args[2] !== 'undefined') {
        animation.setCharge(parseInt(args[2], 10));
    } else {
        animation.setCharge(50);
    }
}

animation.start();
animation.finished.then(() => {
    process.exit(0);
});
